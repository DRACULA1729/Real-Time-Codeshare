# /etc/codeshare/env  (chmod 640 root:codeshare). Values used on the shared VPS.
SPRING_PROFILES_ACTIVE=prod,postgres
DB_URL=jdbc:postgresql://127.0.0.1:5432/codeshare
DB_USER=codeshare
DB_PASSWORD=generate-with-openssl-rand-hex-24
CODESHARE_ALLOWED_ORIGINS=https://sushant-codeshare.duckdns.org
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=8080
MANAGEMENT_PORT=9091
MANAGEMENT_SERVER_ADDRESS=127.0.0.1
SPRING_THREADS_VIRTUAL_ENABLED=true
JAVA_TOOL_OPTIONS=-Xmx512m -XX:+UseSerialGC
