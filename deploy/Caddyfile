# Caddy terminates TLS (Let's Encrypt, automatic) and proxies to the app.
# WebSocket upgrades pass through reverse_proxy untouched.
{
	servers {
		# When Cloudflare proxies the site, take the real client IP from its header,
		# and only trust that header when the hop actually came from Cloudflare.
		# Ranges: https://www.cloudflare.com/ips-v4 and /ips-v6 (refresh occasionally).
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP
	}
}

{$PUBLIC_HOST} {
	encode zstd gzip

	# Detail-free health for the uptime monitor. Actuator lives on the internal
	# management port; nothing else from it is exposed.
	handle /actuator/health {
		reverse_proxy app:9091
	}

	handle {
		reverse_proxy app:8080 {
			# Overwrite, never append: the app rate-limits per X-Forwarded-For.
			header_up X-Forwarded-For {client_ip}
		}
	}
}

