# cp env.example .env   (never commit .env)
PUBLIC_HOST=codeshare.example.com
DB_PASSWORD=change-me-long-random

# Optional: GitHub push. Leave blank to disable. Redirect URI must be https and
# match the OAuth app's callback: https://<PUBLIC_HOST>/api/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=
